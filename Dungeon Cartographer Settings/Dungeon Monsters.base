filters:
  and:
    - file.inFolder("Source Data/Monsters")

views:
  - type: table
    name: Dungeon Monsters (Underground / Any)
    filters:
      and:
        - or:
            - note.terrain_hex.contains("Underground")
            - note.terrain_hex.contains("Any")
    order:
      - file.name
      - Challenge_Rating
      - Type
      - Size
      - terrain_hex
    sort:
      - property: file.name
        direction: ASC
      - property: Challenge_Rating
        direction: ASC
